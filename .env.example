# Copy to .env and fill in your receive addresses. Never commit .env.

# --- Required ---
# Your Base/EVM address that receives USDC. Use a dedicated wallet.
PAYTO_ADDRESS=0xYourReceiveAddress

# --- Network ---
# Base Sepolia (testnet, default): eip155:84532
# Base mainnet (real USDC):        eip155:8453
NETWORK=eip155:84532

# Price of GET /hello (and any route you add the same way)
PRICE=$0.01
PORT=4021
HOST=0.0.0.0
SERVICE_NAME=My x402 API
# Public URL once deployed, used in OpenAPI / llms.txt / discovery.
# PUBLIC_BASE_URL=https://your-api.example.com

# --- Facilitators ---
# auto (default):
#   testnet  -> PayAI public facilitator
#   mainnet  -> Coinbase CDP if CDP keys are set, else FACILITATOR_URL
# cdp: always use CDP (needs keys)
# url: always use FACILITATOR_URL or the network default
FACILITATOR=auto
# FACILITATOR_URL=https://facilitator.payai.network

# Coinbase CDP (recommended on Base mainnet). Create a CDP API key in the
# Coinbase Developer Platform. Leave blank on testnet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# PayAI as a second facilitator (Solana + Base fallback, Bazaar catalog).
# Enabled by default. Disable with PAYAI_ENABLED=0.
PAYAI_ENABLED=1
# PAYAI_FACILITATOR_URL=https://facilitator.payai.network
# Optional PayAI API keys (1,000 free credits without them):
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=
# After a successful CDP verify on Base, mirror the verify to PayAI so the
# route is catalogued in PayAI's Bazaar. Disable with PAYAI_MIRROR_VERIFY=0.
PAYAI_MIRROR_VERIFY=1

# Solana USDC (optional). Set a Solana address that already has a USDC
# token account. Leave blank to stay Base-only.
# SOLANA_PAY_TO=

# --- Optional Stripe MPP (Tempo USDC) ---
# Inert until all three are set. The 402 then also includes
# WWW-Authenticate: Payment method="tempo".
# STRIPE_SECRET_KEY=
# STRIPE_PROFILE_ID=profile_...
# TEMPO_DEPOSIT_ADDRESS=0x...
# MPP_ENABLED=1
# MPP_HOSTED_FEE_PAYER=1
# DATABASE_URL=   # optional; MPP receipts use in-memory store without it
